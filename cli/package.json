{
  "name": "surface-cli",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Surface CLI: a types engine on Supabase, with Markdown checkouts",
  "bin": {
    "surface": "bin/surface"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --no-warnings test/e2e.ts",
    "test:cloud": "SURFACE_STORE=cloud node --no-warnings test/e2e.ts",
    "test:cloud-migrations": "node --no-warnings test/cloud-migrations.ts",
    "test:schema": "node --no-warnings test/schema-operations.ts",
    "test:watch": "node --no-warnings test/watch.ts",
    "test:sync": "node --no-warnings test/sync.ts",
    "test:sync:cloud": "SYNC_HUB=cloud node --no-warnings test/sync.ts",
    "test:team": "node --no-warnings test/team.ts",
    "test:links": "node --no-warnings test/links.ts",
    "test:inverse": "node --no-warnings test/inverse.ts",
    "test:workflow": "node --no-warnings test/workflow.ts",
    "test:updates": "node --no-warnings test/updates.ts",
    "test:apps": "node --no-warnings test/apps.ts",
    "test:system": "node --no-warnings test/system.ts",
    "test:local-repair": "node --no-warnings test/local-repair.ts",
    "test:restart": "node --no-warnings test/restart.ts",
    "test:logging": "bash test/logging.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@supabase/supabase-js": "^2.117.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
