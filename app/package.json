{
  "name": "surface-app",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "qa:browsers": "npm run build && playwright test",
    "qa:safari": "npm run build && node qa/native-safari.mjs",
    "qa:data": "node --import tsx qa/qa-data.mjs",
    "qa:apps": "node --import tsx qa/qa-app-switcher.mjs && node --import tsx qa/qa-app-shell.mjs && node --import tsx qa/qa-api-navigation.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@radix-ui/colors": "^3.0.0",
    "core-js": "^3.51.0",
    "react": "^19.3.1",
    "react-data-grid": "^7.0.0-beta.61",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "21.0.3",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
